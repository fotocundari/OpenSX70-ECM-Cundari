{
	"version": "2.0.0",
	"tasks": [
		{
            "label": "Build Release & Flash",
            "type": "shell",
			"dependsOn": "CMake: build",
            "command": "/Program Files/STMicroelectronics/STM32Cube/STM32CubeProgrammer/bin/STM32_Programmer_CLI.exe",
            "args": [
                "-c", "port=SWD", "mode=UR",
                "-d", "${workspaceFolder}/OpenSX70_ECM/build/Release/OpenSX70_ECM.elf",
                "-v",
                "-rst"
            ],
            "group": "build",
            "problemMatcher": []
        },
		{
			"type": "shell",
			"label": "CMake: Build Debug",
			"command": "cmake",
			"args": [
				"--build",
				"--preset",
				"Debug"
			],
			"options": {
				"cwd": "${workspaceFolder}/OpenSX70_ECM"
			},
			"group": {
				"kind": "build",
				"isDefault": true
			},
			"problemMatcher": [
				"$gcc"
			],
			"detail": "Build the CMake project",
			"dependsOn": [
				"CMake: Configure Debug"
			]
		},
		{
			"type": "shell",
			"label": "CMake: Build Release",
			"command": "cmake",
			"args": [
				"--build",
				"--preset",
				"Release"
			],
			"options": {
				"cwd": "${workspaceFolder}/OpenSX70_ECM"
			},
			"group": "build",
			"problemMatcher": [
				"$gcc"
			],
			"detail": "Build the CMake project in Release mode",
			"dependsOn": [
				"CMake: Configure Release"
			]
		},
		{
			"type": "shell",
			"label": "CMake: Clean",
			"command": "cmake",
			"args": [
				"-E",
				"rm",
				"-rf",
				"${workspaceFolder}/OpenSX70_ECM/build"
			],
			"problemMatcher": [],
			"detail": "Clean build directory"
		}
	]
}